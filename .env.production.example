# Скопируйте в .env.production на сервере и заполните значения.
# НЕ коммитьте .env.production с реальными секретами.

# --- App ---
APP_NAME=Chistyy Bereg
ENVIRONMENT=production
SECRET_KEY=ЗАМЕНИТЕ_НА_ДЛИННУЮ_СЛУЧАЙНУЮ_СТРОКУ_64_СИМВОЛА
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
FRONTEND_URL=https://cleanshore.ru
BACKEND_URL=https://cleanshore.ru
CORS_ORIGINS=https://cleanshore.ru,https://www.cleanshore.ru

# --- Database ---
POSTGRES_USER=chistyy
POSTGRES_PASSWORD=ЗАМЕНИТЕ_НА_СИЛЬНЫЙ_ПАРОЛЬ
POSTGRES_DB=chistyy_bereg

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- OAuth (опционально) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://cleanshore.ru/api/v1/auth/oauth/github/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://cleanshore.ru/api/v1/auth/oauth/yandex/callback

# --- Email (2FA / сброс пароля). Mailpit на проде НЕ использовать. ---
# Вариант A: Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@cleanshore.ru
# Вариант B: SMTP (например Mail.ru / Yandex)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=true
SMTP_FROM=noreply@cleanshore.ru
EMAIL_OTP_TTL_MINUTES=10
TOTP_ISSUER=ChistyyBereg

# --- AI (опционально) ---
AI_PROVIDER=openai_compatible
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Media ---
MEDIA_ROOT=/app/media
MAX_UPLOAD_MB=20
OCR_ENABLED=true

# --- Frontend (на этапе Docker build уже задаётся /api/v1) ---
VITE_API_URL=/api/v1
VITE_APP_NAME=Чистый берег
