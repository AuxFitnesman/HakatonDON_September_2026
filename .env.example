# --- App ---
APP_NAME=Chistyy Bereg
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
POSTGRES_USER=chistyy
POSTGRES_PASSWORD=chistyy_secret
POSTGRES_DB=chistyy_bereg
DATABASE_URL=postgresql+psycopg://chistyy:chistyy_secret@db:5432/chistyy_bereg

# --- Redis (sessions / rate-limit / offline sync queue) ---
REDIS_URL=redis://redis:6379/0

# --- OAuth GitHub ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/github/callback

# --- OAuth Yandex ---
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/yandex/callback

# --- 2FA / Email OTP ---
TOTP_ISSUER=ChistyyBereg
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM=noreply@chistyy.local
EMAIL_OTP_TTL_MINUTES=10

# --- AI ---
AI_PROVIDER=openai_compatible
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_SYSTEM_PROMPT=You are an assistant for the ecological project Chistyy Bereg.

# --- Media / OCR ---
MEDIA_ROOT=/app/media
MAX_UPLOAD_MB=20
OCR_ENABLED=true

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME=Чистый берег
